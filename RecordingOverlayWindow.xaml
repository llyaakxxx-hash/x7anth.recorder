<Window x:Class="x7anth.recorder.RecordingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="x7anth.recorder overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        Background="#2B2B2B"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#2B2B2B"
            BorderBrush="#454545"
            BorderThickness="1"
            Padding="9,5">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6"
                     Height="6"
                     Fill="#8A4444"
                     VerticalAlignment="Center"
                     Margin="0,0,7,0" />
            <TextBlock Text="Идёт запись"
                       Foreground="#A8A8A8"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBlock x:Name="TimerTextBlock"
                       Text="00:00"
                       Foreground="#C4C4C4"
                       FontFamily="Consolas"
                       FontSize="11"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
