<Window x:Class="x7anth.recorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="x7anth.recorder"
        Width="460"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#2B2B2B"
        Foreground="#E6E6E6"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Плоский тёмный стиль ComboBox без стандартных белых/синих рамок Windows -->
        <Style x:Key="FlatComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="#2F2F2F"
                                BorderBrush="#454545"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L4,4 L8,0 Z"
                                      Fill="#A0A0A0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D3D3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Background" Value="#2F2F2F" />
            <Setter Property="BorderBrush" Value="#454545" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource FlatComboBoxToggleButton}"
                                          Grid.ColumnSpan="2"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,6,28,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="False"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="180"
                                        Background="#363636"
                                        BorderBrush="#454545"
                                        BorderThickness="1">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#363636" />
                        <Setter Property="Foreground" Value="#E6E6E6" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#4A4A4A" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#525252" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#525252" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#454545" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Recording">
                                <Setter TargetName="Bd" Property="Background" Value="#7A3B3B" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8F4A4A" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Idle" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#5E5E5E" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Recording" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#8A4545" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя навигация: ровно 2 вкладки -->
        <Border Grid.Row="0"
                Background="#363636"
                BorderBrush="#454545"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="TabRecordButton"
                             Grid.Column="0"
                             Content="Запись"
                             GroupName="NavigationTabs"
                             Style="{StaticResource TopNavTabStyle}"
                             IsChecked="True"
                             Checked="NavigationTab_Checked" />

                <Border Grid.Column="1" Background="#454545" />

                <RadioButton x:Name="TabAuthorButton"
                             Grid.Column="2"
                             Content="Автор"
                             GroupName="NavigationTabs"
                             Style="{StaticResource TopNavTabStyle}"
                             Checked="NavigationTab_Checked" />
            </Grid>
        </Border>

        <!-- Вкладка 1: Запись -->
        <StackPanel x:Name="RecordTabPanel"
                    Grid.Row="1"
                    Margin="16">

            <!-- Уведомление об отсутствии FFmpeg -->
            <Border x:Name="FfmpegMissingBanner"
                    Visibility="Collapsed"
                    Background="#363636"
                    BorderBrush="#7A3B3B"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Не найден ffmpeg.exe рядом с программой или в системном PATH. Поместите ffmpeg.exe в папку с x7anth.recorder.exe."
                               Foreground="#E6E6E6"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button Grid.Column="1"
                            Content="Обновить"
                            Style="{StaticResource FlatButtonStyle}"
                            Padding="10,6"
                            FontSize="12"
                            Click="RecheckFfmpegButton_Click" />
                </Grid>
            </Border>

            <!-- Индикатор свободной памяти -->
            <Border Background="#363636"
                    BorderBrush="#454545"
                    BorderThickness="1"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Память на диске"
                               Foreground="#A0A0A0"
                               FontSize="11.5"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="DiskSpaceTextBlock"
                               Text="Проверка свободного места..."
                               Foreground="#E6E6E6"
                               FontSize="13" />
                </StackPanel>
            </Border>

            <!-- Настройки видео -->
            <Border Background="#363636"
                    BorderBrush="#454545"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Разрешение"
                                   Foreground="#A0A0A0"
                                   FontSize="11.5"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="Формат: MP4"
                                   Foreground="#A0A0A0"
                                   FontSize="11.5"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="Res720Button"
                                     Grid.Column="0"
                                     Content="720p (1280x720)"
                                     GroupName="ResolutionGroup"
                                     Style="{StaticResource SegmentedOptionStyle}"
                                     Checked="ResolutionOption_Checked" />
                        <RadioButton x:Name="Res1080Button"
                                     Grid.Column="2"
                                     Content="1080p (1920x1080)"
                                     GroupName="ResolutionGroup"
                                     Style="{StaticResource SegmentedOptionStyle}"
                                     Checked="ResolutionOption_Checked" />
                    </Grid>

                    <TextBlock Text="Частота кадров"
                               Foreground="#A0A0A0"
                               FontSize="11.5"
                               Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="Fps30Button"
                                     Grid.Column="0"
                                     Content="30 FPS"
                                     GroupName="FpsGroup"
                                     Style="{StaticResource SegmentedOptionStyle}"
                                     Checked="FpsOption_Checked" />
                        <RadioButton x:Name="Fps60Button"
                                     Grid.Column="2"
                                     Content="60 FPS"
                                     GroupName="FpsGroup"
                                     Style="{StaticResource SegmentedOptionStyle}"
                                     Checked="FpsOption_Checked" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Настройки звука -->
            <Border Background="#363636"
                    BorderBrush="#454545"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Запись звука"
                               Foreground="#A0A0A0"
                               FontSize="11.5"
                               Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="AudioOffButton"
                                     Grid.Column="0"
                                     Content="Без звука"
                                     GroupName="AudioGroup"
                                     Style="{StaticResource SegmentedOptionStyle}"
                                     Checked="AudioOption_Checked" />
                        <RadioButton x:Name="AudioOnButton"
                                     Grid.Column="2"
                                     Content="Со звуком"
                                     GroupName="AudioGroup"
                                     Style="{StaticResource SegmentedOptionStyle}"
                                     Checked="AudioOption_Checked" />
                    </Grid>

                    <StackPanel x:Name="AudioDevicePanel"
                                Visibility="Collapsed"
                                Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="AudioDevicesComboBox"
                                      Grid.Column="0"
                                      Style="{StaticResource FlatComboBoxStyle}"
                                      SelectionChanged="AudioDevicesComboBox_SelectionChanged" />

                            <Button x:Name="RefreshAudioDevicesButton"
                                    Grid.Column="2"
                                    Content="Обновить"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Padding="10,6"
                                    FontSize="12"
                                    Click="RefreshAudioDevicesButton_Click" />
                        </Grid>

                        <TextBlock x:Name="AudioHintTextBlock"
                                   Text=""
                                   Foreground="#A0A0A0"
                                   FontSize="11.5"
                                   Visibility="Collapsed"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Бинд горячей клавиши -->
            <Border Background="#363636"
                    BorderBrush="#454545"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Горячая клавиша"
                                   Foreground="#A0A0A0"
                                   FontSize="11.5"
                                   Margin="0,0,0,3" />
                        <TextBlock Text="Старт и остановка записи глобально"
                                   Foreground="#E6E6E6"
                                   FontSize="12.5" />
                    </StackPanel>

                    <Button x:Name="HotkeyBindButton"
                            Grid.Column="1"
                            Content="F9"
                            MinWidth="128"
                            Style="{StaticResource FlatButtonStyle}"
                            Click="HotkeyBindButton_Click" />
                </Grid>
            </Border>

            <!-- Кнопка Старт / Стоп -->
            <Button x:Name="RecordToggleButton"
                    Content="Начать запись (F9)"
                    Tag="Idle"
                    Style="{StaticResource RecordActionButtonStyle}"
                    Click="RecordToggleButton_Click" />

            <TextBlock x:Name="StatusTextBlock"
                       Text="Готов к записи • Основной монитор"
                       Foreground="#A0A0A0"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
        </StackPanel>

        <!-- Вкладка 2: Автор -->
        <Grid x:Name="AuthorTabPanel"
              Grid.Row="1"
              Visibility="Collapsed"
              MinHeight="380">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="x7anth"
                           Foreground="#E6E6E6"
                           FontFamily="Segoe UI"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />

                <!-- Кликабельная векторная SVG-иконка GitHub -->
                <Button x:Name="GitHubLinkButton"
                        Style="{StaticResource FlatButtonStyle}"
                        Width="44"
                        Height="44"
                        Padding="10"
                        HorizontalAlignment="Center"
                        ToolTip="https://github.com/llyaakxxx-hash"
                        Margin="0,0,0,14"
                        Click="GitHubLinkButton_Click">
                    <Viewbox Stretch="Uniform">
                        <Path Fill="#E6E6E6"
                              Data="M12,2 C6.477,2 2,6.484 2,12.017 C2,16.442 4.865,20.197 8.839,21.522 C9.339,21.614 9.521,21.305 9.521,21.041 C9.521,20.804 9.512,20.175 9.508,19.342 C6.726,19.947 6.139,18.001 6.139,18.001 C5.684,16.845 5.029,16.537 5.029,16.537 C4.121,15.917 5.098,15.93 5.098,15.93 C6.101,16.001 6.629,16.961 6.629,16.961 C7.521,18.49 8.97,18.049 9.541,17.793 C9.631,17.147 9.889,16.706 10.175,16.456 C7.954,16.204 5.62,15.346 5.62,11.515 C5.62,10.424 6.01,9.532 6.649,8.833 C6.546,8.58 6.203,7.563 6.747,6.185 C6.747,6.185 7.586,5.916 9.497,7.211 C10.295,6.989 11.15,6.878 12,6.874 C12.85,6.878 13.705,6.989 14.505,7.211 C16.414,5.916 17.251,6.185 17.251,6.185 C17.797,7.563 17.454,8.58 17.351,8.833 C17.991,9.532 18.379,10.424 18.379,11.515 C18.379,15.356 16.041,16.201 13.813,16.449 C14.172,16.759 14.492,17.371 14.492,18.308 C14.492,19.65 14.48,20.732 14.48,21.041 C14.48,21.307 14.66,21.619 15.168,21.521 C19.138,20.193 22,16.441 22,12.017 C22,6.484 17.522,2 12,2 Z" />
                    </Viewbox>
                </Button>

                <!-- Кнопка "Связаться со мной" с векторной SVG-иконкой Telegram -->
                <Button x:Name="TelegramLinkButton"
                        Style="{StaticResource FlatButtonStyle}"
                        Padding="16,9"
                        HorizontalAlignment="Center"
                        Click="TelegramLinkButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16"
                                 Height="16"
                                 Stretch="Uniform"
                                 Margin="0,0,8,0">
                            <Path Fill="#E6E6E6"
                                  Data="M20.665,3.717 L2.935,10.554 C1.725,11.04 1.732,11.715 2.713,12.016 L7.265,13.436 L17.797,6.791 C18.295,6.488 18.75,6.651 18.376,6.983 L9.843,14.684 L9.841,14.684 L9.843,14.685 L9.529,19.377 C9.989,19.377 10.192,19.166 10.45,18.917 L12.661,16.767 L17.26,20.164 C18.108,20.631 18.717,20.391 18.928,19.379 L21.947,5.151 C22.256,3.912 21.474,3.351 20.665,3.717 Z" />
                        </Viewbox>
                        <TextBlock Text="Связаться со мной"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
